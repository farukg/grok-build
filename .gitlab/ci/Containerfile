FROM docker.io/library/ubuntu:24.04

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        build-essential ca-certificates cmake curl git libssl-dev perl \
        pkg-config protobuf-compiler python3 zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# Keep rustup in the image; install only the selected compiler in the persistent cache.
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs -o /tmp/rustup-init.sh \
    && sh /tmp/rustup-init.sh -y --profile minimal --default-toolchain none --no-modify-path \
    && install /root/.cargo/bin/rustup /usr/local/bin/rustup \
    && ln -s rustup /usr/local/bin/cargo \
    && ln -s rustup /usr/local/bin/rustc \
    && rm /tmp/rustup-init.sh

ARG CARGO_LOCALBUILD_FAMILY_BASE_URL
ARG CARGO_LOCALBUILD_FAMILY_PROJECT_ID
ARG CARGO_LOCALBUILD_FAMILY_PIPELINE_ID
ARG CARGO_LOCALBUILD_FAMILY_JOB_ID
ARG CARGO_LOCALBUILD_FAMILY_COMMIT
ARG CARGO_LOCALBUILD_FAMILY_ARCHIVE_SHA256
ARG CARGO_LOCALBUILD_FAMILY_CARGO_FORK_SHA256
ARG CARGO_LOCALBUILD_FAMILY_SEAL_FILE_SHA256
ARG CARGO_LOCALBUILD_FAMILY_JOB_URL
ARG CARGO_LOCALBUILD_FAMILY_PIPELINE_URL
COPY family-verify.py /usr/local/lib/grok-family-verify.py
RUN --mount=type=secret,id=gitlab_job_token,target=/run/secrets/gitlab_job_token \
    python3 /usr/local/lib/grok-family-verify.py \
    && mkdir -p /opt/sigma/cargo-localbuild \
    && tar -xf /tmp/family-archive.tar -C /opt/sigma/cargo-localbuild \
    && for tool in cargo-localbuild cargo-quick cargo-perf cargo-size cargo-release cargo-remote-bld sig; do \
        test -x "/opt/sigma/cargo-localbuild/bin/$tool"; \
        ln -s "/opt/sigma/cargo-localbuild/bin/$tool" "/usr/local/bin/$tool"; \
    done \
    && rm /tmp/family-archive.tar /tmp/family-complete.toml

ENV CARGO_TERM_COLOR=always \
    CARGO_HOME=/cache/grok-build/cargo \
    RUSTUP_HOME=/cache/grok-build/rustup \
    CARGO_TARGET_DIR=/cache/grok-build/target \
    CARGO_INCREMENTAL=1 \
    PROTOC=/usr/bin/protoc

WORKDIR /build
